{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "DriverrKit",
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "Driverr",
      "target-membership": [
        "Driverr",
      ],
      "membership-exceptions": [
        {
          "target": "Driverr",
          "exclusions": [
            "Info.plist",
            "Driverr.entitlements",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "DriverrTests", "target-membership": [ "DriverrTests" ] },
    { "kind": "folder", "path": "DriverrUITests", "target-membership": [ "DriverrUITests" ] },
    {
      "kind": "folder",
      "path": "DriverrWatch",
      "target-membership": [
        "DriverrWatch",
      ],
      "membership-exceptions": [
        {
          "target": "DriverrWatch",
          "exclusions": [
            "Info.plist",
            "DriverrWatch.entitlements",
          ],
        },
      ],
    },
    { "path": "THIRD-PARTY-NOTICES.md", "target-membership": [ "Driverr/resources" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Driverr.app", "id": "AB01", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/DriverrTests.xctest", "id": "AB02", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/DriverrUITests.xctest", "id": "AB03", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/DriverrWatch.appex", "id": "AB04", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Driverr/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Driverr",
      "id": "DB01",
      "product": "Products/Driverr.app",
      "product-type": "application",
      "dependencies": [
        "DriverrWatch",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "DriverrCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "DriverrHC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "DriverrHerdr",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "DriverrSSH",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "DriverrTerm",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "DriverrTmux",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "DriverrTranscript",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGNING_ALLOWED": "YES",
        "CODE_SIGNING_REQUIRED": "NO",
        "CODE_SIGN_ENTITLEMENTS": "Driverr/Driverr.entitlements",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_IDENTITY[sdk=iphoneos*]": "Apple Development",
        "CODE_SIGN_STYLE": "Manual",
        "CODE_SIGN_STYLE[sdk=iphoneos*]": "Automatic",
        "COPY_PHASE_STRIP": "NO",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "447FMVD577",
        "ENABLE_TESTABILITY[config=Debug]": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Driverr/Info.plist",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "NO",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.cunderw.driverr",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "DriverrTests",
      "id": "DB02",
      "product": "Products/DriverrTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Driverr",
      "dependencies": [
        "Driverr",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGNING_ALLOWED": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.cunderw.driverr.tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Driverr.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Driverr",
      },
    }, {
      "name": "DriverrUITests",
      "id": "DB03",
      "product": "Products/DriverrUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "Driverr",
      "dependencies": [
        "Driverr",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGNING_ALLOWED": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.cunderw.driverr.uitests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "Driverr",
      },
    }, {
      "name": "DriverrWatch",
      "id": "DB04",
      "product": "Products/DriverrWatch.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "DriverrCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CODE_SIGNING_ALLOWED": "YES",
        "CODE_SIGNING_REQUIRED": "NO",
        "CODE_SIGN_ENTITLEMENTS": "DriverrWatch/DriverrWatch.entitlements",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_IDENTITY[sdk=iphoneos*]": "Apple Development",
        "CODE_SIGN_STYLE": "Manual",
        "CODE_SIGN_STYLE[sdk=iphoneos*]": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "447FMVD577",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "DriverrWatch/Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.cunderw.driverr.watch",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
    "MARKETING_VERSION": "1.2.2",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "iphoneos",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_STRICT_CONCURRENCY": "complete",
    "SWIFT_VERSION": "6.0",
    "VALIDATE_PRODUCT[config=Release]": "YES",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "27.0",
}
